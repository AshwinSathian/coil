{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coil",
  // Personal account. The login also has another account, so wrangler needs this to pick one.
  "account_id": "5e8cabf1f94e15e681dfe58d4164a8ed",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // Only the leaderboard API runs code; every other request is a static file from the edge.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "coil-db", "database_id": "c36db975-b9e9-474d-b5e8-efe03e95f8dd", "migrations_dir": "migrations" }
  ],
  // 20 leaderboard submissions per IP per minute, per Cloudflare location.
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "4721", "simple": { "limit": 20, "period": 60 } }],
  "observability": { "enabled": true },
  "workers_dev": true,
  "routes": [{ "pattern": "coil.ashwinsathian.com", "custom_domain": true }]
}
