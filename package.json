{
  "name": "coil",
  "version": "1.0.0",
  "description": "Snake for phone, tablet and desktop, with replays as links and a leaderboard that re-simulates every run.",
  "homepage": "https://coil.ashwinsathian.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AshwinSathian/coil.git"
  },
  "bugs": "https://github.com/AshwinSathian/coil/issues",
  "license": "MIT",
  "author": "Ashwin Sathian",
  "keywords": [
    "snake",
    "game",
    "canvas",
    "typescript",
    "pwa",
    "cloudflare-workers",
    "d1",
    "deterministic-simulation"
  ],
  "engines": {
    "node": ">=24"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "node --test src/*.test.ts",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "wrangler": "^4.165.0"
  }
}
